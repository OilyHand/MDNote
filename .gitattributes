# Store text files with LF line endings in the repository and in the working
# tree, regardless of each machine's core.autocrlf setting.
* text=auto eol=lf

# Windows scripts need CRLF to run correctly.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Test fixtures must keep their exact bytes (CRLF, UTF-16, ANSI code pages),
# so Git must never convert them.
tests/fixtures/** -text

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.webp binary
*.pdf  binary
*.docx binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
