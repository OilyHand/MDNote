{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDNote",
  "version": "0.1.0",
  "identifier": "io.github.oilyhand.mdnote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MDNote",
        "width": 1100,
        "height": 760,
        "minWidth": 560,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "oilyhand",
    "copyright": "Copyright (c) 2026 OilyHand. MIT License.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "Markdown notes with Word-style formatting",
    "longDescription": "MDNote is a Windows Markdown editor with Word-style formatting, page layout, and PDF/Word export.",
    "homepage": "https://github.com/OilyHand/MDNote",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "MDNote.Markdown",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Korean"],
        "displayLanguageSelector": false,
        "startMenuFolder": "MDNote"
      }
    }
  }
}
